+void llama_kv_cache::seq_remap(llama_seq_id seq_id, llama_pos p0, llama_pos p1, const llama_pos * map, size_t n_map) {
+    // TODO: refactor [TAG_KV_CACHE_SHARE_CELLS]
+    if (other) {
+        return;
+    }
+
+    GGML_ASSERT(seq_id >= 0 && (size_t) seq_id < seq_to_stream.size());
+    GGML_ASSERT(hparams.n_pos_per_embd() == 1 && "seq_remap() is only supported for n_pos_per_embd() == 1");
+    GGML_ASSERT(p0 >= 0 && p1 >= p0);
+    GGML_ASSERT(n_map >= (size_t) (p1 - p0));
+
+    auto & cells = v_cells[seq_to_stream[seq_id]];
+    auto & head  = v_heads[seq_to_stream[seq_id]];
+
+    if (p0 == p1) {
+        return;
+    }
+
+    uint32_t new_head = cells.size();
+
+    for (uint32_t i = 0; i < cells.size(); ++i) {
+        if (!cells.pos_in(i, p0, p1)) {
+            continue;
+        }
+
+        if (!cells.seq_has(i, seq_id)) {
+            continue;
+        }
+
+        const llama_pos p_old = cells.pos_get(i);
+        const llama_pos p_new = map[p_old - p0];
+
+        if (p_new < 0) {
+            // forget this cell
+            if (cells.seq_rm(i, seq_id)) {
+                if (new_head == cells.size()) {
+                    new_head = i;
+                }
+            }
+            continue;
+        }
+
+        if (p_new == p_old) {
+            continue;
+        }
+
+        // queues the RoPE shift for this cell (per-cell delta)
+        if (cells.pos_add(i, p_new - p_old)) {
+            if (new_head == cells.size()) {
+                new_head = i;
+            }
+        }
+    }
+
+    head = new_head != cells.size() ? new_head : 0;
+}
+
+// [infinite] ---------------------------------------------------------------------------------
+//
+// Cell-indexed access, used by the two-tier far-context design (examples/infinite):
+//   * the retrieval band owns a fixed, contiguous range of cells, so a gather from host memory
+//     is ONE ggml_backend_tensor_set per layer instead of one per cell;
+//   * the band is always FULL (S cells), so no cell is ever left empty for find_slot() to take
+//     and the cache's max position stays at the trunk's top, which llama_batch_allocr requires.
+
+size_t llama_kv_cache::kv_row_bytes(int32_t * n_layer_out, int32_t * n_embd_k_gqa_out) const {
+    GGML_ASSERT(!layers.empty());
+
+    const auto & layer = layers[0];
+
+    const uint32_t n_embd_k_gqa = hparams.n_embd_k_gqa(layer.il);
+    const uint32_t n_embd_v_gqa = hparams.n_embd_v_gqa(layer.il);
+
+    const size_t k_row = ggml_row_size(layer.k->type, n_embd_k_gqa);
+    const size_t v_row = ggml_row_size(layer.v->type, n_embd_v_gqa);
+
+    GGML_ASSERT(k_row == v_row && "kv_cells_write() assumes matching K/V row sizes");
+
+    if (n_layer_out)      *n_layer_out      = (int32_t) layers.size();
+    if (n_embd_k_gqa_out) *n_embd_k_gqa_out = (int32_t) n_embd_k_gqa;
+
+    return k_row;
+}
+
+bool llama_kv_cache::kv_cells_of(llama_seq_id seq_id, llama_pos p0, llama_pos p1, uint32_t * cell) const {
+    GGML_ASSERT(seq_id >= 0 && (size_t) seq_id < seq_to_stream.size());
+
+    const auto & cells = v_cells[seq_to_stream[seq_id]];
+
+    const size_t n = (size_t) (p1 - p0);
+    for (size_t j = 0; j < n; ++j) {
+        cell[j] = UINT32_MAX;
+    }
+
+    size_t found = 0;
+    for (uint32_t i = 0; i < cells.size(); ++i) {
+        if (cells.is_empty(i) || !cells.seq_has(i, seq_id) || !cells.pos_in(i, p0, p1)) {
+            continue;
+        }
+        const size_t j = (size_t) (cells.pos_get(i) - p0);
+        if (cell[j] == UINT32_MAX) {
+            cell[j] = i;
+            found++;
+        }
+    }
+
+    return found == n;
+}
+
+void llama_kv_cache::kv_cells_read(llama_seq_id seq_id, const uint32_t * cell, size_t n, void * k, void * v) const {
+    GGML_ASSERT(seq_id >= 0 && (size_t) seq_id < seq_to_stream.size());
+    GGML_ASSERT(!v_trans && "kv_cells_read() needs a non-transposed V cache (flash attention)");
+
+    if (n == 0) {
+        return;
+    }
+
+    const uint32_t strm = seq_to_stream[seq_id];
+
+    for (size_t li = 0; li < layers.size(); ++li) {
+        const auto & layer = layers[li];
+
+        const size_t row = ggml_row_size(layer.k->type, hparams.n_embd_k_gqa(layer.il));
+
+        size_t j = 0;
+        while (j < n) {
+            size_t m = 1;
+            while (j + m < n && cell[j + m] == cell[j + m - 1] + 1) {
+                m++;
+            }
+            if (k) {
+                ggml_backend_tensor_get(layer.k_stream[strm], (char *) k + (li*n + j)*row, (size_t) cell[j]*row, m*row);
+            }
+            if (v && layer.v_stream[strm]) {
+                ggml_backend_tensor_get(layer.v_stream[strm], (char *) v + (li*n + j)*row, (size_t) cell[j]*row, m*row);
+            }
+            j += m;
+        }
+    }
+}
+
+void llama_kv_cache::kv_cells_place(llama_seq_id seq_id, const uint32_t * cell, const llama_pos * dst, size_t n) {
+    GGML_ASSERT(seq_id >= 0 && (size_t) seq_id < seq_to_stream.size());
+
+    auto & cells = v_cells[seq_to_stream[seq_id]];
+
+    for (size_t j = 0; j < n; ++j) {
+        const uint32_t i = cell[j];
+        GGML_ASSERT(i < cells.size());
+        GGML_ASSERT(!cells.is_empty(i));
+
+        const llama_pos d = dst[j] - cells.pos_get(i);
+        if (d != 0) {
+            cells.pos_add(i, d);
+        }
+    }
+}
+
+void llama_kv_cache::kv_cells_state(llama_seq_id seq_id, uint32_t c0, size_t n,
+                                    llama_pos * pos, llama_token * tok) const {
+    GGML_ASSERT(seq_id >= 0 && (size_t) seq_id < seq_to_stream.size());
+
+    const auto & cells = v_cells[seq_to_stream[seq_id]];
+
+    for (size_t j = 0; j < n; ++j) {
+        const uint32_t i = c0 + (uint32_t) j;
+        GGML_ASSERT(i < cells.size());
+
+        if (cells.is_empty(i) || !cells.seq_has(i, seq_id)) {
+            if (pos) pos[j] = -1;
+            if (tok) tok[j] = LLAMA_TOKEN_NULL;
+            continue;
+        }
+
+        if (pos) pos[j] = cells.pos_get(i);
+        if (tok) tok[j] = cells.ext_get(i).tok;
+    }
+}
+
+void llama_kv_cache::kv_cells_write(llama_seq_id seq_id, uint32_t c0, size_t n,
+                                    const llama_pos * src, const llama_pos * dst,
+                                    const void * k, const void * v,
+                                    const llama_token * tok) {
+    GGML_ASSERT(seq_id >= 0 && (size_t) seq_id < seq_to_stream.size());
+    GGML_ASSERT(!v_trans && "kv_cells_write() needs a non-transposed V cache (flash attention)");
+
+    if (n == 0) {
+        return;
+    }
+
+    const uint32_t strm = seq_to_stream[seq_id];
+
+    auto & cells = v_cells[strm];
+
+    GGML_ASSERT(c0 + n <= cells.size());
+
+    // free the range, then claim it at the position the stored keys were RoPEd at
+    for (size_t j = 0; j < n; ++j) {
+        const uint32_t i = c0 + (uint32_t) j;
+        if (!cells.is_empty(i)) {
+            cells.rm(i);
+        }
+        cells.pos_set(i, src[j]);
+        cells.seq_add(i, seq_id);
+        if (tok) {
+            llama_kv_cell_ext ext;
+            ext.tok = tok[j];
+            cells.ext_set(i, ext);
+        }
+    }
+
+    // one host->device copy per layer per tensor
+    for (size_t li = 0; li < layers.size(); ++li) {
+        const auto & layer = layers[li];
+
+        const size_t row = ggml_row_size(layer.k->type, hparams.n_embd_k_gqa(layer.il));
+
+        if (k) {
+            ggml_backend_tensor_set(layer.k_stream[strm], (const char *) k + li*n*row, (size_t) c0*row, n*row);
+        }
+        if (v && layer.v_stream[strm]) {
+            ggml_backend_tensor_set(layer.v_stream[strm], (const char *) v + li*n*row, (size_t) c0*row, n*row);
+        }
+    }
+
+    // queue the re-rotation from the stored position to the slot position
+    for (size_t j = 0; j < n; ++j) {
+        if (dst[j] != src[j]) {
+            cells.pos_add(c0 + (uint32_t) j, dst[j] - src[j]);
+        }
+    }
+}
