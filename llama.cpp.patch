+// [infinite] effective per-plane RoPE angular frequencies, including freq_scale and the
+// model's frequency factors (llama3 / long-rope).  See llama_model_rope_thetas() in llama.h.
+int32_t llama_model_rope_thetas(const llama_model * model, float * out, int32_t n_out) {
+    const uint32_t n_rot = model->hparams.n_rot();
+    const int32_t n_planes = (int32_t) n_rot / 2;
+
+    if (n_out < n_planes) {
+        return -n_planes;
+    }
+
+    const float base  = model->hparams.rope_freq_base_train;
+    const float scale = model->hparams.rope_freq_scale_train;
+
+    std::vector<float> ff;
+    if (!model->layers.empty() && model->layers[0].rope_freqs != nullptr) {
+        ggml_tensor * rf = model->layers[0].rope_freqs;
+        ff.resize(ggml_nelements(rf));
+        ggml_backend_tensor_get(rf, ff.data(), 0, ggml_nbytes(rf));
+    }
+
+    for (int32_t j = 0; j < n_planes; ++j) {
+        float theta = scale * powf(base, -2.0f*j/(float) n_rot);
+        if (j < (int32_t) ff.size() && ff[j] != 0.0f) {
+            theta /= ff[j];
+        }
+        out[j] = theta;
+    }
+
+    return n_planes;
+}
+
 float llama_model_rope_freq_scale_train(const llama_model * model) {
     return model->hparams.rope_freq_scale_train;
 }
