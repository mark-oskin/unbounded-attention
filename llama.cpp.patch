+// [infinite] read back the per-layer Q/K/V kept as graph outputs by capture_qkv()
+int64_t llama_context::get_qkv(int32_t il, int32_t which, int32_t tok0, int32_t n_tokens, float * dst) {
+    // which: 0 = Q, 1 = K (post-rope), 2 = V, 3 = K BEFORE the rope
+    // the result of the last computed graph: upstream keeps one result per output mode and marks
+    // the one it computed last as active
+    llm_graph_result * r = gf_res_prev_active ? gf_res_prev_active : get_gf_res_prev();
+    if (!r || which < 0 || which > 3) {
+        return -1;
+    }
+
+    const auto & vq = r->t_qcur;
+    const auto & vk = r->t_kcur;
+    const auto & vv = r->t_vcur;
+    const auto & vp = r->t_kpre;
+
+    const std::vector<ggml_tensor *> & vec = which == 0 ? vq
+                                           : (which == 1 ? vk
+                                           : (which == 2 ? vv : vp));
+    if (il < 0 || il >= (int32_t) vec.size() || vec[il] == nullptr) {
+        return -1;
+    }
+
+    ggml_tensor * t = vec[il];
+    if (t->type != GGML_TYPE_F32 || !ggml_is_contiguous(t)) {
+        return -1;
+    }
+
+    const int64_t n_row = t->ne[0]*t->ne[1];              // elements per token
+    const int64_t n_tok = ggml_nelements(t) / n_row;
+    if (tok0 < 0 || n_tokens <= 0 || tok0 + n_tokens > n_tok) {
+        return -1;
+    }
+
+    ggml_backend_tensor_get(t, dst, tok0*n_row*sizeof(float), n_tokens*n_row*sizeof(float));
+
+    return n_tokens*n_row;
+}
