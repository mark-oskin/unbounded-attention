+// [infinite] mark this layer's Q/K/V as graph outputs (ggml_gallocr never recycles an output's
+// memory, so the data is still there when llama_decode() returns) and record the tensors.
+void llm_graph_context::capture_qkv(ggml_tensor * q, ggml_tensor * k, ggml_tensor * v, int il) const {
+    if (!cparams.kv_capture || il < 0 || il >= (int) n_layer) {
+        return;
+    }
+
+    if ((int) res->t_qcur.size() != (int) n_layer) {
+        res->t_qcur.assign(n_layer, nullptr);
+        res->t_kcur.assign(n_layer, nullptr);
+        res->t_vcur.assign(n_layer, nullptr);
+    }
+
+    // ggml_set_output() protects a tensor from ggml_gallocr_free_node(), but NOT a tensor that is
+    // a *view*: ggml_gallocr frees the view_src when the view is done with, and the OUTPUT flag on
+    // the view is not consulted.  Vcur is a reshape (a view) of the wv product, so capturing it
+    // directly hands back whatever node was allocated over it later.  ggml_cont() gives each
+    // captured tensor its own allocation; GGML_OP_CONT is not in ggml_op_can_inplace() either.
+    ggml_tensor * tt[3] = { q, k, v };
+    for (int i = 0; i < 3; ++i) {
+        if (!tt[i]) {
+            continue;
+        }
+        ggml_tensor * t = ggml_cont(ctx0, tt[i]);
+        ggml_set_output(t);
+        ggml_build_forward_expand(gf, t);
+        tt[i] = t;
+    }
+
+    res->t_qcur[il] = tt[0];
+    res->t_kcur[il] = tt[1];
+    res->t_vcur[il] = tt[2];
+}
+
+// [infinite] Capture K *before* ggml_rope_ext.  A band cell is read at a slot position that has
+// nothing to do with the position the key was encoded at, so storing the post-RoPE key forces a
+// second rotation (the K-shift) at placement.  Storing the pre-RoPE key lets placement rotate it
+// exactly once, which is also what the compressed store needs: a pre-RoPE key quantises without
+// the position baked into it.
+void llm_graph_context::capture_kpre(ggml_tensor * k, int il) const {
+    if (!cparams.kv_capture || il < 0 || il >= (int) n_layer || !k) {
+        return;
+    }
+    if ((int) res->t_kpre.size() != (int) n_layer) {
+        res->t_kpre.assign(n_layer, nullptr);
+    }
+    ggml_tensor * t = ggml_cont(ctx0, k);
+    ggml_set_output(t);
+    ggml_build_forward_expand(gf, t);
+    res->t_kpre[il] = t;
+}
+
 
 
 ggml_tensor * llm_graph_context::build_cvec(
